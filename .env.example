# ==============================================================================
# SURAKSHA SETU — ENVIRONMENT CONFIGURATION TEMPLATE
# Target: Rajasthan Police Cyber Security Hackathon (Cyber Fraud / Phishing / APKs)
# Security Notice: NEVER commit production API keys or service role secrets to Git!
# ==============================================================================

# Server Network Configuration
PORT=8088
HOST=0.0.0.0
NODE_ENV=development

# Frontend Application Origin (CORS Allowed Origins)
FRONTEND_URL=http://localhost:8088

# Supabase PostgreSQL Configuration
# Obtain from Supabase Project Settings -> API & Database
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Session Security & Hashing
SESSION_SECRET=suraksha_setu_master_jwt_secret_key_2026_super_secure
AUTH_SALT=suraksha_setu_salt_2026

# External Threat Intelligence APIs
# Note: If API keys are empty or unconfigured, Suraksha Setu automatically
# activates deterministic demonstration intelligence with high-fidelity telemetry.

# VirusTotal v3 API (https://www.virustotal.com/gui/my-apikey)
VIRUSTOTAL_API_KEY=

# AbuseIPDB v2 API (https://www.abuseipdb.com/account/api)
ABUSEIPDB_API_KEY=

# URLhaus API (abuse.ch - public feed queryable without key or with Auth-Key)
URLHAUS_API_KEY=

# Google Safe Browsing API v4 (Google Cloud Console)
GOOGLE_SAFE_BROWSING_API_KEY=

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Law Enforcement Agency Jurisdictional Defaults
DEFAULT_POLICE_STATION=Cyber Police Station Central, Delhi
DEFAULT_STATE_CELL=State Cyber Crime Investigation Directorate
